# Supabase — necessário para os formulários (Solicitar Serviço / Ser Profissional)
# gravarem dados reais. Sem isto a app continua a funcionar (mostra o ecrã de
# sucesso à mesma), mas nada é guardado.
#
# Copie este ficheiro para `.env` e preencha com os valores do seu projeto Supabase:
#   Settings → API → Project URL  e  anon public key

VITE_SUPABASE_URL=https://o-seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=a-sua-anon-key
