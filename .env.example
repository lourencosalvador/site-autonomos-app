# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (site Vite) — expostos no browser. Só chaves PÚBLICAS aqui.
# Copie para `.env`.  Settings → API → Project URL + anon public key.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://o-seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=a-sua-anon-key

# ─────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION `provision-account` — secrets de SERVIDOR.
# NÃO pôr aqui no .env do site (o Vite expõe tudo). Definir com:
#   supabase secrets set NOME=valor
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados automaticamente pela
# plataforma; só precisa de definir os restantes.
# ─────────────────────────────────────────────────────────────────────────────
#   PROVISION_SECRET=<string aleatória forte>   # igual ao que está em private.provision_config
#   TWILIO_ACCOUNT_SID=ACxxxxxxxx
#   TWILIO_AUTH_TOKEN=xxxxxxxx
#   # remetente: UM dos dois
#   TWILIO_FROM=+1xxxxxxxxxx                     # nº Twilio, OU
#   TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
